<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_green">

    <!-- App Bar (Fixed at top) -->
    <RelativeLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_700"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🐄" android:textSize="32sp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cow Profile Setup" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Progress Dots -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp">
                <View android:id="@+id/dot1" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="@drawable/dot_active"/>
                <View android:layout_width="24dp" android:layout_height="3dp" android:background="@color/green_200"/>
                <View android:id="@+id/dot2" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="@drawable/dot_inactive"/>
                <View android:layout_width="24dp" android:layout_height="3dp" android:background="@color/green_200"/>
                <View android:id="@+id/dot3" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="@drawable/dot_inactive"/>
                <View android:layout_width="24dp" android:layout_height="3dp" android:background="@color/green_200"/>
                <View android:id="@+id/dot4" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="@drawable/dot_inactive"/>
                <View android:layout_width="24dp" android:layout_height="3dp" android:background="@color/green_200"/>
                <View android:id="@+id/dot5" android:layout_width="32dp" android:layout_height="32dp"
                    android:background="@drawable/dot_inactive"/>
            </LinearLayout>

            <!-- Step 1: Breed -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step_breed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step1_label" android:textColor="@color/green_500"
                        android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step1_question" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_breeds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/item_breed_selection"
                        tools:itemCount="6"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 2: Age -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp" android:visibility="gone"
                app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step2_label" android:textColor="@color/green_500"
                        android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step2_question" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/age_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_age"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:text="4"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 3: Weight -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp" android:visibility="gone"
                app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step3_label" android:textColor="@color/green_500"
                        android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step3_question" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/weight_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_weight"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="numberDecimal" android:text="350"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 4: Current Yield -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step_current_yield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp" android:visibility="gone"
                app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step4_label" android:textColor="@color/green_500"
                        android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step4_question" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
                    <TextView android:id="@+id/tv_current_yield_val"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="6.0L" android:textSize="28sp" android:textStyle="bold"
                        android:textColor="@color/green_700" android:gravity="center"/>
                    <SeekBar android:id="@+id/seek_current_yield"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="50" android:progress="12" android:layout_marginTop="8dp"
                        android:progressTint="@color/green_500" android:thumbTint="@color/green_700"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Step 5: Target Yield -->
            <androidx.cardview.widget.CardView
                android:id="@+id/step_target_yield"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp" android:visibility="gone"
                app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step5_label" android:textColor="@color/green_500"
                        android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step5_question" android:textSize="18sp"
                        android:textStyle="bold" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
                    <TextView android:id="@+id/tv_target_yield_val"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="10.0L" android:textSize="28sp" android:textStyle="bold"
                        android:textColor="@color/green_700" android:gravity="center"/>
                    <SeekBar android:id="@+id/seek_target_yield"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="60" android:progress="20" android:layout_marginTop="8dp"
                        android:progressTint="@color/green_500" android:thumbTint="@color/green_700"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/step5_hint" android:textSize="10sp"
                        android:textColor="@color/text_muted" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Container for Buttons (Fixed at bottom) -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_green"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <include android:id="@+id/step_buttons"
            layout="@layout/include_step_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
