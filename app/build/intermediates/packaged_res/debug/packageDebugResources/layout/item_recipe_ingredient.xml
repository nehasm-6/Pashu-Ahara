<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <View android:id="@+id/accent_bar"
            android:layout_width="5dp" android:layout_height="match_parent"
            android:layout_marginEnd="14dp" android:minHeight="60dp"
            android:background="@color/green_500"/>
        <TextView android:id="@+id/tv_ing_emoji"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="32sp" android:layout_marginEnd="14dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_ing_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_ing_local"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/text_muted"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/tv_ing_qty"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/green_700"/>
            <TextView android:id="@+id/tv_ing_cost"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/text_muted"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
